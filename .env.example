# 本地演示无需任何密钥
DATABASE_PATH=./data/laicommerce.db
WEB_URL=http://127.0.0.1:3000
MCP_URL=http://127.0.0.1:3101/mcp
A2A_URL=http://127.0.0.1:3102
AGENT_TOKEN_PEPPER=replace-in-production
WEBHOOK_SECRET=replace-in-production
UPLOAD_MAX_MB=20
WORKBENCH_ACCESS_TOKEN=
# 启动数据：demo 为本地演示资料；blank 为不会在重启后重新灌入演示资料的空白测试项目
LAI_SEED_MODE=demo

# 文本模型：可选 auto / openai / openrouter / mock
# auto 优先使用 OpenAI，其次 OpenRouter，均未配置时使用可预测 Mock
LAI_TEXT_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://127.0.0.1:3000
OPENROUTER_APP_NAME=LaiCommerce Studio

# 图片模型：deterministic 只生成 SVG 构图预览；pollinations 调用真实图片模型
# Pollinations 可使用账户免费额度；Secret Key 只能放在服务端
LAI_IMAGE_PROVIDER=deterministic
LAI_REQUIRE_LIVE_OUTPUTS=false
POLLINATIONS_TEXT_API_KEY=
POLLINATIONS_TEXT_MODEL=nemotron-3.5-lightning
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=zimage
POLLINATIONS_REFERENCE_IMAGE_MODEL=klein

# 其他可选外部 Provider
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DOCLING_URL=
COMFYUI_URL=
DIFY_URL=
DIFY_API_KEY=
RAGFLOW_URL=
RAGFLOW_API_KEY=
N8N_WEBHOOK_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
